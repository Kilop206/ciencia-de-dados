  "title": "Grupo 3 | Streaming Industrial (IIoT/Kafka)",
  "description": "Pipeline HTTP -> Kafka -> Python ETL -> InfluxDB -> Grafana. Leituras de sensores simuladas.",
  "schemaVersion": 40,
  "version": 1,
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
